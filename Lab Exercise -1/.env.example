# CreatorIQ Backend Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
PORT=5000
SECRET_KEY=creatoriq-super-secret-key-change-in-production

# Upload limits (Default: 2GB)
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=2147483648

# YouTube Data API v3 Configuration
# Add your Google Cloud Console API key here (DO NOT commit your actual key)
YOUTUBE_API_KEY=

# YouTube Analytics API Configuration (OAuth 2.0 Client credentials)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:5000/api/youtube/oauth/callback

# FFmpeg / FFprobe Binaries Path (Leave as default if installed in system PATH)
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
